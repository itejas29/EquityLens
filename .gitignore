# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Env
.env
!.env.example
!frontend/.env

# Node / frontend
node_modules/
dist/

# OS
.DS_Store

# Logs
*.log

# ML artifacts (regenerated by python -m app.ml.train)
backend/app/ml/artifacts/*.joblib
backups/

# frontend/.env is deliberately NOT ignored (see the ! rule above): Vite inlines
# every VITE_* var into the public bundle at build time, so nothing secret can
# live there by definition. It holds one localhost API URL.
