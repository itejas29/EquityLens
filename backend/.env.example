ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg2://equitylens:equitylens@localhost:5432/equitylens

REDIS_URL=redis://localhost:6380/0

# Must be at least 32 characters — the app refuses to start otherwise, so the
# old placeholder here is no longer a working configuration. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

CORS_ORIGINS=http://localhost:5173

# Optional — AI trading activity notifications. Leave unset to disable.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Lab scripts (backend/scripts/phase*) refuse any database not on this machine.
# To run one against a remote experiment copy (e.g. a Neon branch), list that
# host here, comma-separated. Never list production.
# LAB_DB_HOSTS=
